    {
      "name": "9. [Bônus] Atualizar Apenas Valor (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valor\": 38.50\n}"
        },
        "url": {
          "raw": "http://localhost:8080/pratos/1/valor",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
