          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"\",\n  \"descricao\": \"Prato inválido\",\n  \"valor\": -10.00,\n  \"categoria\": \"vegano\",\n  \"calorias\": -5,\n  \"quantidade\": 0,\n  \"unidadeMedida\": \"\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/pratos",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "pratos"
          ]
        },
        "description": "Valida bloqueio de dados inválidos pelo Bean Validation com HTTP 400 Bad Request."
