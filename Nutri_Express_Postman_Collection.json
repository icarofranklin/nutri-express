    {
      "name": "10. [Bônus] Filtrar por Calorias Máximas (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/pratos/calorias?max=300",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "pratos",
            "calorias"
          ],
          "query": [
            {
              "key": "max",
              "value": "300"
