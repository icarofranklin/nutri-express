      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/pratos/999",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "pratos",
            "999"
          ]
        },
        "description": "Testa o retorno 404 Not Found para IDs inexistentes."
