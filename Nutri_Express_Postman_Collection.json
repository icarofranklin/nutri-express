        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bowl Tropical de Quinoa\",\n  \"descricao\": \"Quinoa real com legumes salteados, castanhas e molho cítrico\",\n  \"valor\": 34.90,\n  \"categoria\": \"vegano\",\n  \"calorias\": 280,\n  \"quantidade\": 380.0,\n  \"unidadeMedida\": \"g\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/pratos",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "pratos"
          ]
        },
        "description": "Cadastra um novo prato no sistema."
      }
    },
    {
      "name": "2. Listar Todos os Pratos (GET)",
      "request": {
        "method": "GET",
