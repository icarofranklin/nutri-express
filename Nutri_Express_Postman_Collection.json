        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Salada Tropical Especial com Tofu\",\n  \"descricao\": \"Mix de folhas verdes nobres, manga, tomate cereja e tofu defumado grelhado\",\n  \"valor\": 36.00,\n  \"categoria\": \"vegano\",\n  \"calorias\": 240,\n  \"quantidade\": 360.0,\n  \"unidadeMedida\": \"g\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/pratos/1",
          "protocol": "http",
          "host": [
